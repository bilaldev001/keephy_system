{
  "name": "keephy-platform",
  "version": "1.0.0",
  "description": "Keephy Platform - Complete system with microservices and frontend applications",
  "private": true,
  "scripts": {
    "test": "node scripts/test-system.mjs",
    "test:critical": "node scripts/test-system.mjs --critical-only",
    "start": "./scripts/start-all.sh",
    "start:critical": "./scripts/start-all.sh --critical-only",
    "start:simple": "node scripts/test-system.mjs --critical-only --skip-install --skip-migrations",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:critical": "pm2 start ecosystem.config.js --only api-gateway,identity-service,access-service,admin-service,frontend-admin",
    "pm2:start:backend": "pm2 start ecosystem.config.js --only 'api-gateway,identity-service,access-service,admin-service,media-service,contacts-service,notifications-service,audit-service,billing-service,hrms-service,analytics-service,crm-service,ai-service,payroll-service,subscriptions-service,entitlements-service,compliance-service,ems-service,facilities-service,onboarding-service,integration-service,lifecycle-service,mobile-service'",
    "pm2:start:frontend": "pm2 start ecosystem.config.js --only 'frontend-admin,frontend-analytics,frontend-billing,frontend-hrms,frontend-crm'",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:stop:all": "pm2 stop all",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:restart:all": "pm2 restart all",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:delete:all": "pm2 delete all",
    "pm2:logs": "pm2 logs",
    "pm2:logs:admin": "pm2 logs frontend-admin",
    "pm2:logs:gateway": "pm2 logs api-gateway",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:resurrect": "pm2 resurrect",
    "pm2:startup": "pm2 startup",
    "install:all": "cd backend && npm install --legacy-peer-deps && cd ../frontend && npm install",
    "clean": "rm -rf .pids .logs node_modules backend/node_modules frontend/node_modules .pm2",
    "clean:pm2": "pm2 delete all && pm2 kill",
    "logs:backend": "tail -f .logs/*.log 2>/dev/null | grep -E '(backend|service)' || echo 'No logs found'",
    "logs:frontend": "tail -f .logs/*.log 2>/dev/null | grep -E '(frontend|admin|app)' || echo 'No logs found'",
    "logs": "tail -f .logs/*.log 2>/dev/null || echo 'No logs found'",
    "kill:all": "pkill -f 'npm run start:dev' && pkill -f 'npm run dev' || true",
    "check:ports": "lsof -i :4000,4001,4002,4003,4004,4028,4205,4206,4207,4209,4213 || echo 'No services running on checked ports'"
  },
  "keywords": [
    "hrms",
    "microservices",
    "nestjs",
    "nextjs",
    "admin"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3"
  }
}
