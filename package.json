{
  "name": "keephy-platform",
  "version": "1.0.0",
  "description": "Keephy Platform - Complete system with microservices and frontend applications",
  "private": true,
  "scripts": {
    "test": "node scripts/test-system.mjs",
    "test:critical": "node scripts/test-system.mjs --critical-only",
    "start": "./scripts/start-all.sh",
    "start:critical": "./scripts/start-all.sh --critical-only",
    "start:simple": "node scripts/test-system.mjs --critical-only --skip-install --skip-migrations",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:critical": "pm2 start ecosystem.config.js --only api-gateway,identity-service,access-service,admin-service,frontend-admin",
    "pm2:start:all": "./start-all-pm2.sh",
    "pm2:start:backend": "./start-backend-pm2.sh",
    "pm2:start:frontend": "./start-frontend-pm2.sh",
    "pm2:stop:all": "./stop-all-pm2.sh",
    "pm2:stop:backend": "./stop-backend-pm2.sh",
    "pm2:stop:frontend": "./stop-frontend-pm2.sh",
    "pm2:restart:backend": "pm2 restart ecosystem.backend.config.js",
    "pm2:restart:frontend": "pm2 restart ecosystem.frontend.config.js",
    "pm2:delete:backend": "pm2 delete ecosystem.backend.config.js",
    "pm2:delete:frontend": "pm2 delete ecosystem.frontend.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:logs:backend": "pm2 logs --only api-gateway,identity-service,access-service",
    "pm2:logs:frontend": "pm2 logs --only frontend-admin,frontend-marketing",
    "pm2:logs:admin": "pm2 logs frontend-admin",
    "pm2:logs:gateway": "pm2 logs api-gateway",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:resurrect": "pm2 resurrect",
    "pm2:startup": "pm2 startup",
    "install:all": "cd backend && npm install --legacy-peer-deps && cd ../frontend && npm install",
    "install:backend": "cd backend && npm install --legacy-peer-deps",
    "install:frontend": "cd frontend && npm install",
    "clean": "rm -rf .pids .logs node_modules backend/node_modules frontend/node_modules .pm2",
    "clean:pm2": "pm2 delete all && pm2 kill",
    "logs:backend": "tail -f .logs/backend/*.log 2>/dev/null || echo 'No logs found'",
    "logs:frontend": "tail -f .logs/frontend/*.log 2>/dev/null || echo 'No logs found'",
    "logs": "tail -f .logs/**/*.log 2>/dev/null || echo 'No logs found'",
    "kill:all": "pkill -f 'npm run start:dev' && pkill -f 'npm run dev' || true",
    "check:ports": "lsof -i :3010,4001,4002,5200,5210 || echo 'No services running on checked ports'"
  },
  "keywords": [
    "hrms",
    "microservices",
    "nestjs",
    "nextjs",
    "admin"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3"
  }
}
