# Production Environment Variables
# Copy this file to .env.production and customize with real values
# NEVER commit this file with real secrets!

# ============================================
# Backend Services Ports (5000-5150, increment of 5)
# ============================================
PORT=5000
IDENTITY_SERVICE_URL=http://identity-service:5005
ACCESS_SERVICE_URL=http://access-service:5010
TENANT_SERVICE_URL=http://tenant-service:5015
MEDIA_SERVICE_URL=http://media-service:5020
FBMS_SERVICE_URL=http://fbms-service:5025
CONTACTS_SERVICE_URL=http://contacts-service:5030
NOTIFICATIONS_SERVICE_URL=http://notifications-service:5035
AUDIT_SERVICE_URL=http://audit-service:5040
SUBSCRIPTIONS_SERVICE_URL=http://subscriptions-service:5045
ENTITLEMENTS_SERVICE_URL=http://entitlements-service:5050
BILLING_SERVICE_URL=http://billing-service:5055
OBSERVABILITY_SERVICE_URL=http://observability-service:5060
HRMS_SERVICE_URL=http://hrms-service:5065
SCM_SERVICE_URL=http://scm-service:5070
PAYROLL_SERVICE_URL=http://payroll-service:5075
INVENTORY_SERVICE_URL=http://inventory-service:5080
CRM_SERVICE_URL=http://crm-service:5085
SUPPORT_SERVICE_URL=http://support-service:5090
COMPLIANCE_SERVICE_URL=http://compliance-service:5095
ANALYTICS_SERVICE_URL=http://analytics-service:5100
EMS_SERVICE_URL=http://ems-service:5105
VOUCHER_SERVICE_URL=http://voucher-service:5110
FORMS_SERVICE_URL=http://forms-service:5115
BUILDER_SERVICE_URL=http://builder-service:5120
ONBOARDING_SERVICE_URL=http://onboarding-service:5125
ADMIN_SERVICE_URL=http://admin-service:5130
AI_SERVICE_URL=http://ai-service:5135
LIFECYCLE_SERVICE_URL=http://lifecycle-service:5140
INTEGRATION_SERVICE_URL=http://integration-service:5145
MOBILE_SERVICE_URL=http://mobile-service:5150

# ============================================
# Frontend URLs (external - use your actual domain)
# ============================================
NEXT_PUBLIC_GATEWAY_URL=https://api.keephy.com
NEXT_PUBLIC_MARKETING_URL=https://www.keephy.com
NEXT_PUBLIC_CONSOLE_URL=https://console.keephy.com
NEXT_PUBLIC_ROOT_DOMAIN=keephy.com

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_DB=hrmssystem
DATABASE_URL=postgresql://postgres:CHANGE_THIS_TO_STRONG_PASSWORD@postgres:5432/hrmssystem

# ============================================
# JWT Configuration (MUST USE STRONG SECRETS!)
# ============================================
JWT_ACCESS_SECRET=CHANGE_THIS_TO_VERY_STRONG_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_VERY_STRONG_SECRET_MIN_32_CHARS
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
BCRYPT_SALT_ROUNDS=12

# ============================================
# Environment
# ============================================
NODE_ENV=production

# ============================================
# Optional Service-Specific Variables
# ============================================
# Builder Service
BUILDER_JWT_SECRET=CHANGE_THIS_TO_STRONG_SECRET
STRIPE_SECRET_KEY=CHANGE_THIS_TO_REAL_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=CHANGE_THIS_TO_REAL_WEBHOOK_SECRET

# Onboarding Service
DEMO_TENANT_ID=CHANGE_THIS_TO_REAL_TENANT_ID

# Observability Service
SERVICE_TARGETS=optional

# ============================================
# Security Notes
# ============================================
# - Enable HTTPS
# - Use Docker secrets for sensitive data
# - Enable rate limiting
# - Enable CORS properly
# - Rotate secrets regularly
# - Use strong passwords (min 32 characters for JWT secrets)
