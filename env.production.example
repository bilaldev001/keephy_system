# ============================================
# Frontend URLs (external - use your actual domain)
# ============================================
NEXT_PUBLIC_GATEWAY_URL=https://api.keephy.com
NEXT_PUBLIC_MARKETING_URL=https://www.keephy.com
NEXT_PUBLIC_CONSOLE_URL=https://console.keephy.com
NEXT_PUBLIC_ADMIN_URL=https://admin.keephy.com
NEXT_PUBLIC_MODULE_BUILDER_URL=https://builder.keephy.com
NEXT_PUBLIC_MODULE_FORMS_URL=https://forms.keephy.com
NEXT_PUBLIC_MODULE_HRMS_URL=https://hrms.keephy.com
NEXT_PUBLIC_MODULE_VOUCHERS_URL=https://vouchers.keephy.com
NEXT_PUBLIC_MODULE_FBMS_URL=https://fbms.keephy.com
NEXT_PUBLIC_MODULE_CRM_URL=https://crm.keephy.com
NEXT_PUBLIC_MODULE_BILLING_URL=https://billing.keephy.com
NEXT_PUBLIC_MODULE_ANALYTICS_URL=https://analytics.keephy.com
NEXT_PUBLIC_MODULE_COMPLIANCE_URL=https://compliance.keephy.com
NEXT_PUBLIC_MODULE_EMS_URL=https://ems.keephy.com
NEXT_PUBLIC_MODULE_INVENTORY_URL=https://inventory.keephy.com
