# Staging Environment Variables
# Copy this file to .env.staging and customize with real values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=hrmssystem_staging
POSTGRES_PORT=5433
STAGING_DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration (USE STRONG SECRETS IN PRODUCTION!)
JWT_ACCESS_SECRET=CHANGE_THIS_TO_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_STRONG_SECRET
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
BCRYPT_SALT_ROUNDS=12

# Service URLs (internal Docker network)
IDENTITY_SERVICE_URL=http://identity-service:4001
ACCESS_SERVICE_URL=http://access-service:4002
MEDIA_SERVICE_URL=http://media-service:4003
TENANT_SERVICE_URL=http://tenant-service:4023

# Frontend URLs (external)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4100
NEXT_PUBLIC_MARKETING_URL=http://localhost:4300
NEXT_PUBLIC_ROOT_DOMAIN=staging.keephy.com

# Environment
NODE_ENV=staging

