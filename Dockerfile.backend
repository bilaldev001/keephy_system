# Backend Services Dockerfile
# Base image for all NestJS backend services

FROM node:22

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy root package files (if any)
COPY package*.json ./

# Copy backend package files
COPY backend/package*.json ./backend/

# Install root dependencies and rebuild native modules
RUN cd backend && npm install --legacy-peer-deps || true && \
    npm rebuild bcrypt --build-from-source || true

# Copy backend source (will be overridden by volume in dev)
COPY backend/ ./backend/

# Set working directory for service commands
WORKDIR /app/backend

# Default command (will be overridden in docker-compose)
CMD ["npm", "run", "start:dev"]

